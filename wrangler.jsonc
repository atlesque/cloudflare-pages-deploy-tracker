{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cloudflare-pages-deploy-tracker",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
